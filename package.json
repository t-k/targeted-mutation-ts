{
  "name": "targeted-mutation",
  "version": "0.1.0",
  "description": "Find the tests a JavaScript or TypeScript suite is missing by trying small, targeted source edits against it.",
  "keywords": [
    "mutation-testing",
    "testing",
    "test-quality",
    "typescript",
    "javascript",
    "vitest",
    "playwright",
    "boundary-value"
  ],
  "license": "Apache-2.0",
  "author": "Tatsuo Kaniwa",
  "homepage": "https://github.com/t-k/targeted-mutation-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-k/targeted-mutation-ts.git"
  },
  "bugs": {
    "url": "https://github.com/t-k/targeted-mutation-ts/issues"
  },
  "private": true,
  "type": "module",
  "bin": {
    "targeted-mutation": "bin/tmt.mjs",
    "tmts": "bin/tmt.mjs"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "evidence:m0": "node scripts/evidence-m0.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:typescript-syntax": "node scripts/build-typescript-syntax.mjs",
    "verify:fstar": "sh scripts/verify-fstar.sh",
    "pretest": "npm run build:native && npm run build:compiler && npm run build:typescript-syntax && npm run build:lean",
    "audit:extraction": "node scripts/audit-extraction.mjs",
    "build:lean": "node scripts/build-lean.mjs",
    "build:typescript-cache": "node scripts/prepare-typescript.mjs",
    "test:e2e": "node --test test/playwright.integration.mjs",
    "evidence:m3": "node scripts/evidence-m3.mjs",
    "bench:extraction": "node scripts/bench-extraction.mjs",
    "bench:analysis": "node scripts/bench-analysis.mjs",
    "pack:runtime": "npm run build:lean && node scripts/pack-runtime.mjs",
    "test:native-profile": "node --test test/native-profile.integration.mjs",
    "test:package": "node scripts/test-package.mjs",
    "build:compiler": "node scripts/build-compiler.mjs",
    "verify:compiler": "sh scripts/verify-compiler.sh",
    "publish:packages": "node scripts/publish-packages.mjs"
  },
  "dependencies": {
    "typescript": ">=5.9.3 <7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "esbuild": "0.28.2",
    "vitest": "4.0.18",
    "yuku-parser": "0.19.0"
  },
  "files": [
    "bin/",
    "src/",
    "build/typescript-syntax/",
    "docs/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
