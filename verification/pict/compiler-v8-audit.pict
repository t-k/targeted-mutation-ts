Phase: TS, JSX, TSX, PassThrough
Verdict: Accept, Reject
Fixture: Initial, Subsequent
Certification: Certified, Uncertified, Unreported
Guard: Accepts, Objects, Unreported
IF [Phase] IN {"JSX", "PassThrough"} THEN [Certification] = "Unreported" AND [Guard] = "Unreported";
IF [Certification] = "Unreported" THEN [Guard] = "Unreported";
