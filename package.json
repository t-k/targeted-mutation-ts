{
  "name": "targeted-mutation-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tmt-ts": "bin/tmt.mjs"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "evidence:m0": "node scripts/evidence-m0.mjs",
    "build:native": "node scripts/build-native.mjs",
    "verify:fstar": "sh scripts/verify-fstar.sh",
    "pretest": "npm run build:native && npm run build:lean",
    "audit:extraction": "node scripts/audit-extraction.mjs",
    "build:lean": "node scripts/build-lean.mjs",
    "test:e2e": "node --test test/playwright.integration.mjs",
    "evidence:m3": "node scripts/evidence-m3.mjs",
    "bench:extraction": "node scripts/bench-extraction.mjs",
    "bench:analysis": "node scripts/bench-analysis.mjs",
    "pack:runtime": "npm run build:native && npm run build:lean && node scripts/pack-runtime.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@babel/generator": "8.0.10",
    "@babel/types": "8.1.2",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "yuku-parser": "0.19.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1"
  },
  "files": [
    "bin/",
    "src/",
    "build/tmt.node",
    "build/tmt-decide",
    "README.md",
    "docs/",
    "evidence/"
  ]
}
